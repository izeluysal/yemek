# Ortam değişkenleri (development için örnek)
# .env dosyasını oluşturup aşağıdaki değerleri düzenle

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# Sunucu
PORT=5003

# Veritabanı
DB_PATH=data/app.db

# Dosya Yükleme
UPLOAD_FOLDER=yemekfiles
MAX_FILE_SIZE=10485760

# Admin Şifresi (bcrypt ile hash'lenmiş)
# Varsayılan: admin
# Değiştirmek için: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yeni_sifre'))"
ADMIN_PASSWORD_HASH=$2b$12$...

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5003
